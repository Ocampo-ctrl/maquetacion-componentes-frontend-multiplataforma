            "templateData": "<main class=\"layout\">\n  <section class=\"menu\">\n    <h1>Restaurante La Bonga del Sinú</h1>\n    <div class=\"menu__grid\">\n      @for (p of products; track p.id) {\n        <app-product-card\n          [title]=\"p.name\"\n          [description]=\"p.desc\"\n          [price]=\"p.price\"\n          (add)=\"add(p)\"\n        />\n      }\n    </div>\n  </section>\n\n  <aside class=\"side\" [class.side--open]=\"drawerOpen\">\n    <app-order-summary\n      [items]=\"cart\"\n      (increase)=\"increase($event)\"\n      (decrease)=\"decrease($event)\"\n      (confirm)=\"confirm()\"\n    />\n  </aside>\n\n  <button class=\"fab\" (click)=\"drawerOpen = !drawerOpen\">\n    {{ drawerOpen ? 'Cerrar' : 'Ver pedido (' + count + ')' }}\n  </button>\n</main>\n"
