            "templateData": "<section class=\"summary\">\n  <h2 class=\"summary__title\">Resumen del pedido</h2>\n\n  @if (items.length === 0) {\n    <p class=\"summary__empty\">Aún no has agregado productos.</p>\n  } @else {\n    <ul class=\"summary__list\">\n      @for (item of items; track item.id) {\n        <li class=\"item\">\n          <div class=\"item__info\">\n            <span class=\"item__name\">{{ item.name }}</span>\n            <span class=\"item__price\">{{ money(item.price * item.qty) }}</span>\n          </div>\n          <div class=\"qty\">\n            <button class=\"qty__btn\" (click)=\"decrease.emit(item.id)\" aria-label=\"Quitar uno\">−</button>\n            <span class=\"qty__value\">{{ item.qty }}</span>\n            <button class=\"qty__btn\" (click)=\"increase.emit(item.id)\" aria-label=\"Agregar uno\">+</button>\n          </div>\n        </li>\n      }\n    </ul>\n\n    <dl class=\"totals\">\n      <div><dt>Subtotal</dt><dd>{{ money(subtotal) }}</dd></div>\n      <div><dt>IVA ({{ ivaRate * 100 }}%)</dt><dd>{{ money(iva) }}</dd></div>\n      <div class=\"totals__total\"><dt>Total</dt><dd>{{ money(total) }}</dd></div>\n    </dl>\n  }\n\n  <app-button\n    label=\"Confirmar pedido\"\n    variant=\"secondary\"\n    [disabled]=\"items.length === 0\"\n    (clicked)=\"confirm.emit()\"\n  />\n</section>\n"
        },
