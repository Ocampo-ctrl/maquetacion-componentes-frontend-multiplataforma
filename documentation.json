            "styleUrlsData": [
                {
                    "data": ".layout {\n  display: grid;\n  grid-template-columns: 1fr 360px;\n  gap: var(--space-6);\n  max-width: 1200px;\n  margin: 0 auto;\n  padding: var(--space-6);\n}\n\n.menu h1 { font-size: var(--font-size-h1); margin-top: 0; }\n.menu__grid {\n  display: grid;\n  grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));\n  gap: var(--space-4);\n}\n\n.side { position: sticky; top: var(--space-6); align-self: start; }\n.fab { display: none; }\n\n/* Móvil: el resumen pasa a un drawer inferior */\n@media (max-width: 768px) {\n  .layout { grid-template-columns: 1fr; padding: var(--space-4); padding-bottom: 96px; }\n\n  .side {\n    position: fixed;\n    left: 0; right: 0; bottom: 0;\n    max-height: 80vh;\n    overflow-y: auto;\n    padding: var(--space-4);\n    padding-bottom: 80px;\n    background: var(--color-bg);\n    transform: translateY(100%);\n    transition: transform 0.25s ease;\n    z-index: 10;\n  }\n  .side--open { transform: translateY(0); }\n\n  .fab {\n    display: block;\n    position: fixed;\n    left: var(--space-4); right: var(--space-4); bottom: var(--space-4);\n    min-height: var(--touch-target);\n    border: none;\n    border-radius: var(--radius);\n    background: var(--color-primary);\n    color: var(--color-on-primary);\n    font-size: var(--font-size-body);\n    font-weight: var(--font-weight-bold);\n    cursor: pointer;\n    z-index: 20;\n  }\n}\n",
