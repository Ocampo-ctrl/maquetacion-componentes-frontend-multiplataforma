            "styleUrlsData": [
                {
                    "data": ".card {\n  display: flex;\n  flex-direction: column;\n  background: var(--color-surface);\n  border: 1px solid var(--color-border);\n  border-radius: var(--radius);\n  box-shadow: var(--shadow);\n  overflow: hidden;\n}\n\n.card__media {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  height: 140px;\n  background: var(--color-border);\n}\n.card__media img { width: 100%; height: 100%; object-fit: cover; }\n.card__placeholder { font-size: 3rem; }\n\n.card__body {\n  display: flex;\n  flex-direction: column;\n  gap: var(--space-2);\n  flex: 1;\n  padding: var(--space-4);\n}\n\n.card__title { margin: 0; font-size: var(--font-size-h3); }\n.card__desc { margin: 0; flex: 1; font-size: var(--font-size-label); color: var(--color-text-muted); }\n\n.card__footer {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-2);\n}\n\n.badge {\n  padding: var(--space-1) var(--space-2);\n  border-radius: 999px;\n  background: var(--color-secondary);\n  color: #fff;\n  font-size: var(--font-size-label);\n  font-weight: var(--font-weight-bold);\n}\n\n/* Pantallas pequeñas: tarjeta horizontal */\n@media (max-width: 480px) {\n  .card { flex-direction: row; }\n  .card__media { width: 110px; height: auto; flex-shrink: 0; }\n  .card__footer { flex-wrap: wrap; }\n}\n",
